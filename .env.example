# BudgetingApp server configuration
# Copy to .env and adjust. Every value is optional; the defaults shown here are
# what the server uses when the variable is unset.

# --- Networking -------------------------------------------------------------
# Address the server binds to inside the container. Leave as 0.0.0.0 for Docker;
# the host-side exposure is controlled by BUDGET_PUBLISH_ADDR below.
BUDGET_HOST=0.0.0.0
BUDGET_PORT=8000

# Host interface and port the container is published on.
# Use your Tailscale IP (e.g. 100.x.y.z) to expose the app only to your tailnet.
BUDGET_PUBLISH_ADDR=0.0.0.0
BUDGET_PUBLISH_PORT=8000

# --- Storage ----------------------------------------------------------------
# Directory holding budget.db and the generated signing key.
BUDGET_DATA_DIR=/data

# Optional explicit database file path (overrides BUDGET_DATA_DIR for the DB).
# BUDGET_DATABASE_PATH=/data/budget.db

# --- Security ---------------------------------------------------------------
# Signs session tokens. Generate with: openssl rand -base64 48
# If unset, a key is generated and persisted to BUDGET_DATA_DIR/.secret_key.
# BUDGET_SECRET_KEY=

# How long a login stays valid. Active use extends it (sliding expiry).
BUDGET_SESSION_LIFETIME_DAYS=30

# Set to true when the app is reached over HTTPS (e.g. behind `tailscale serve`).
# Required for the session cookie to be sent on HTTPS-only setups.
BUDGET_SECURE_COOKIES=false

# Failed-login throttling, per client IP and username.
BUDGET_LOGIN_MAX_ATTEMPTS=10
BUDGET_LOGIN_LOCKOUT_SECONDS=300

# --- Frontend / CORS --------------------------------------------------------
# Serve the bundled React web UI from this server.
BUDGET_SERVE_FRONTEND=true

# Comma-separated browser origins allowed to call the API. The web UI is served
# from the same origin, so this is only needed for the Electron desktop client
# or a separately hosted frontend.
# BUDGET_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
